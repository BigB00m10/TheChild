''Is there something you want to do in here?''
<<set _workEmoji = $player.gender != "man" ? "👷‍♀️" : "👷‍♂️">>\
<<if Now.is('8:30')>>\
    @@color:red;You need to go to work@@
    <<keyOption "Go to work" work _workEmoji>>
<<else>>\
    <<keyOption "Watch TV" watchTv 📺>>: 30min
    <<if $now.hour lte 8>>\
        <<keyOption "Go to work" work _workEmoji>>
    <</if>>\
    <<keyOption "Go outside" neighborhood 🚪>>
    <<keyOption "The Basement" basement 🔒>>
    <<keyOption "Your Bedroom" bed 🛌>>
<</if>>\