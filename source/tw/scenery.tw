:: scenery [widget]
<<widget scenery>>\
    <<nobr>>\
        <<set _base64 to null>>
        <<switch $args[0]>>
            <<case dump>>
                <<set _base64 to "">>
            <<case playground>>
                <<set _base64 to "">>
            <<case bed>>
                <<set _base64 to "">>
            <<case mainRoom>>
                <<set _base64 to "">>
            <<case basement>>
                <<set _base64 to "">>
            <<case home>>
                <<set _base64 to "">>
        <</switch>>
    <</nobr>>\
    <<if _base64 != null>>\
        <<set _base64 to "data:image/jpeg;base64," + _base64>>\
        <img class="centerHouse" @src="_base64">
        <hr>
    <</if>>\
<</widget>>\