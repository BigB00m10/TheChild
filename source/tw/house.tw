        <div class="one-half column">\
            <<if $slaves.length > 0>>\
                Slaves:
                <<set _slaveIndex to 0>>\
                <<for _slave range $slaves>>\
                    <<print "<<link '_slave.name (_slave.age y.o. _slave.hairColor hair)' slave>><<set $slave to " + JSON.stringify(_slave) + ", $slave.index to " + _slaveIndex + ">><</link>>">>
                    <<set _slaveIndex++>>\
                <</for>>\
            <</if>>\
        </div>\
        <div class="one-half column">\
            <<set _avaliableBeds to Basement.avaliableBeds()>>
