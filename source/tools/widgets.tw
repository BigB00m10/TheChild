:: widgets [widget nobr] {"position":"425,300"}
<<widget emoji>><<if $settings.emoji === false>><<set _style to "display:none">><</if>><span class='emoji' @style="_style">_args[0]</span><</widget>>
<<widget addMinutes>>
    <<run Now.addMinutes(_args[0])>>
<</widget>>
<<widget addHours>>
    <<run Now.addHours(_args[0])>>
<</widget>>
<<widget cash>>
    <<run $player.cash = Math.round(($player.cash + _args[0]) * 100) / 100
        ;_cashAction = _args[0] < 1 ? 'lost' : 'received'
        ;_cashColor = _args[0] < 1 ? 'red' : 'green'>>
    @@color:_cashColor;You _cashAction ¤<<- Math.abs(_args[0]).toFixed(2)>>@@
<</widget>>
<<widget workOption>>
    <<set _workEmoji = $player.gender != "boy" ? "👷‍♀️" : "👷‍♂️"; _workText = "Go to work" + (Now.isWeekend()?" (Optional)":"")>>
    <<keyOption [[_workText|work]] _workEmoji>>
<</widget>>
<<widget sleep>>
    <<set $player.sleeping = true;
        Now.skipTo("7:00 AM")>>
    <<goto bed>>
<</widget>>
<<widget unlessEmergency container>>
    <<if $player.energy lt 1>>
        @@color:red;You REALLY need to sleep@@<br>
        <<keyAction 'Go to sleep' 😴>><<sleep>><</keyAction>>
    <<else>>
        <<if $player.job && !Now.isWeekend() && !$player.workedToday && Now.isEqualOrLaterThan($player.job.enterTime)>>
            @@color:red;You need to go to work@@<br>
            <<workOption>>
        <<else>>
            _contents
        <</if>>
    <</if>>
<</widget>>
<<widget checkNpcVirgin>>
    <<set _fieldName to _args[0] + 'Virgin'>>
    <<if $npc[_fieldName]>>
        <<set
            $npc[_fieldName] = false;
            Person.setAchievement("playerTook" + _args[0].toUpperFirst() + "Virginity");
        >>
        <br>@@color:red;$npc.name just lost $npc.possessive _args[0] virginity!!!@@<br>
    <<elseif _args[0] != 'mouth' && !Person.hasAchievement("playerTook" + _args[0].toUpperFirst() + "Virginity") && !Person.hasAchievement("playerRealizedNonVirgin")>>
        <br>@@color:yellow;You realize that $npc.name was not a virgin!!@@<br>
        <<run Person.setAchievement("playerRealizedNonVirgin")>>
    <</if>>
    <<run Person.setAchievement('had' + _args[0].toUpperFirst() + 'SexWithPlayer')>>
<</widget>>
<<widget userEditListVar>>
    <<set _list = eval(_args[0]).join('\n')>>
    <<dialog _args[1]>>
        <<textarea "_newList" _list>><br>
        <<button "✅ Save">>
            <<run eval(_args[0] + '=' + JSON.stringify(_newList.split(/\r?\n/)));Dialog.close()>>
        <</button>>
        <<if _args[2]>>
            <<button "♻ Reset to default">><<set
                _newList = eval(_args[2]).join('\n');
                $('#textarea--newlist').val(_newList);  
            >><</button>>
        <</if>>
        <span id="escAct"><<button "❌ (Esc) Cancel">>
            <<run Dialog.close()>>
        <</button>></span>
    <</dialog>>
<</widget>>
<<widget npcAddressPlayer>><<- Player.getAddressing(_args[0] || $npc)>><</widget>>
<<widget npcStats>>
    <<set _npc to _args[0] || $npc>>
    <<if typeof _npc == 'number'>>
        <<set _npc to Person.get(_npc)>>
    <</if>>
    <<run
        ['love', 'obedience', 'lust', 'pussyTraining', 'anusTraining', 'mouthTraining'].forEach(function(name) {
            Meter.del(name);
            Meter.add(name, {
                label: name.beautifyStat() + ':' + _npc[name],
                height: '20px'
            }, _npc[name] / 100);
        });
        ['freedomWish', 'hunger', 'fear'].forEach(function(name) {
            Meter.del(name);
            Meter.add(name, {
                label: name.beautifyStat() + ':' + _npc[name],
                height: '20px',
                full: '#FF4136',
                empty: '#2ECC40'
            }, _npc[name] / 100);
        });
    >>
    <div class="row">
        <<if _npc.fear>>
            <div class="one-third column">
                <<showmeter fear>>
            </div>
        <</if>>
        <<if _npc.love>>
            <div class="one-third column">
                <<showmeter love>>
            </div>
        <</if>>
        <<if _npc.obedience>>
            <div class="one-third column">
                <<showmeter obedience>>
            </div>
        <</if>>
    </div>
    <div class="row">
        <<if _npc.lust>>
            <div class="one-third column">
                <<showmeter lust>>
            </div>
        <</if>>
        <<if _npc.freedomWish>>
            <div class="one-third column">
                <<showmeter freedomWish>>
            </div>
        <</if>>
        <<if _npc.hunger>>
            <div class="one-third column">
                <<showmeter hunger>>
            </div>
        <</if>>
    </div>
    <div class="row">
        <<if _npc.pussyTraining>>
            <div class="one-third column">
                <<showmeter pussyTraining>>
            </div>
        <</if>>
        <<if _npc.anusTraining>>
            <div class="one-third column">
                <<showmeter anusTraining>>
            </div>
        <</if>>
        <<if _npc.mouthTraining>>
            <div class="one-third column">
                <<showmeter mouthTraining>>
            </div>
        <</if>>
    </div>
    <<unset _npc>>
<</widget>>
<<widget personProperties>>
    <<npcStats _args[0]>>
    <<set _npc to _args[0] || $npc>>
    <<if typeof _npc == 'number'>>
        <<set _npc to Person.get(_npc)>>
    <</if>>
    location: _npc.location <<button "Go there" _npc.location>><<run Dialog.close()>><</button>><br>
    <<if $cheat>>\
        Personality preset: $npc.uniqueness.name <<button change>><<set _dialogTitle = "Personality for " + _npc.name>><<dialog _dialogTitle>>
            <<for _presetIndex = 0; _presetIndex lt PersonUniquenessPresets.length; _presetIndex++>>
                <<set _preset = PersonUniquenessPresets[_presetIndex]>>
                <<print '<<button "_preset.name (' + Person.getPersonalityDescription(_preset) + ')">><<set _npc.uniqueness = PersonUniquenessPresets[' + _presetIndex + '];Dialog.close()>><</button>>'>>
                <<unset _preset>>
            <</for>>
        <</dialog>><</button>><br>
        Characteristics: <<- Person.getPersonalityDescription($npc.uniqueness)>>
    <</if>>
<</widget>>
<<widget npcGenderSymbol>>
    <<set _genderSymbol = _args[0].sex == 'male' ? '♂' : _args[0].sex == 'female' ? '♀' : '⚤'>>
    <<emoji _genderSymbol>><<unset _genderSymbol>>
<</widget>>
<<widget printPersonLink>>
    <<npcGenderSymbol _args[0]>>
    <<print "<<link '" + (_args[2] ? _args[2] + ' ' : '') +  Person.getShortDescription(_args[0]) + "'>>" + _args[1] + "<</link>>">>
<</widget>>
<<widget wanderingSlaves>>
    <<set _wandering = Person.getWandering()>>
    <<if _wandering.length>>
        <<if _wandering.length == 1>>
            <<set _linkText = "(A) " + _wandering[0].name>>
            <span id="aKeyAct"><<link _linkText>><<openNpcInteraction houseSlave _wandering[0].uid>><</link>></span> is here.<br>
        <<else>>
            <<set 
                _last = _wandering.pop();
                _charcode = 97;
            >>
            <<for _slave range _wandering>>
                <<set
                    if(_charcode == 104) _charcode += 2; 
                    _char = String.fromCharCode(_charcode++);
                    _linkText = '(' + _char.toUpperCase() + ') ' + _slave.name;
                    _keyId = _char + 'KeyAct';
                >><span @id='_keyId'><<print '<<link _linkText>><<openNpcInteraction houseSlave ' + _slave.uid + '>><</link>>'>></span>,
            <</for>>
            <<set 
                _char = String.fromCharCode(_charcode);
                _linkText = '(' + _char.toUpperCase() + ') ' + _last.name;
                _keyId = _char + 'KeyAct';
            >>
            and <span @id='_keyId'>
                <<link _linkText>><<openNpcInteraction houseSlave _last.uid>><</link>>
            </span> are here.<br>
        <</if>>
    <</if>>
<</widget>>
<<widget playerSay>>''$player.name'': "_args[0]"<</widget>>
<<widget npcSay>>
    <<set _npc = _args[1] ? _args[1] : $npc>>
    ''_npc.name'': "_args[0]"
    <<unset _npc>>
<</widget>>
<<widget personHunting>>
    <<set $found_kid = Person.generate($settings.childGeneration)>>
    You found a <<- Person.getLongDescription($found_kid)>> named $found_kid.name<br><br>
    <<if Player.has('magic sunglasses')>>
        <label style="cursor:pointer"><<checkbox '$settings.usingMagicSunglasses' false true autocheck>> Put on magic sunglasses.<<emoji 😎>></label><br>
        <<set _npcStatsStyle = $settings.usingMagicSunglasses ? '' : 'display:none'>>
        <span id='npcStats' @style='_npcStatsStyle'>
            <<npcStats $found_kid>>
            Traits: <<- Person.getPersonalityDescription($found_kid.uniqueness)>><br>
        </span><br>
        <script>
            $('#checkbox-settingsusingmagicsunglasses').on('change', function() {
                $('#npcStats').toggle(this.checked)
            })
        </script>
    <</if>>
    <<set
        _hasChloroform = Player.has('chloroform');
        _hasCandy = Player.has('Candy');
    >>
    <<if !_hasChloroform and !_hasCandy>>
        (You don't have anything at your disposal to obtain kids)<br>
    <<elseif Basement.availableBeds() lte 0>>
        (Not enough space for a new kid back at home)<br>
    <<else>>
        <<if _hasCandy>>
            <<keyOption [[Offer $found_kid.name some Candy.|CandyLure]] 🍬>>: 9min<br>
        <</if>>
        <<if _hasChloroform>>
            <<keyOption [[Kidnap $found_kid.pronoun|kidnap]] 🖐>>: 30min<br>
        <</if>>
    <</if>>
<</widget>>
<<widget sleepOption>>
    <<if !$player.job or $player.workedToday or Now.isWeekend() or Now.isBetween('12:00 AM', '06:59 AM')>>
        <<set 
            _sleepSlave = $slaves.firstOrDefault(function(slave){return Person.hasAchievement('okSleepWithPlayer', slave)});
            _sleepSentence = $scenery != 'bed' ? "Go sleep" : 'Sleep';
        >>
        <<if _sleepSlave>>
            <<set _sleepSentence+=' with ' + _sleepSlave.name>>
            <<keyAction _sleepSentence 🥰>>
                <<set $scenery = 'bed'>>
                <<openNpcInteraction 'okSleepWithPlayerDemand' _sleepSlave.uid>>
            <</keyAction>>
        <<else>>
            <<keyAction _sleepSentence 😴>><<sleep>><</keyAction>>
        <</if>>
    <</if>>
<</widget>>
<<widget thirdPerson>><<if $npc.gender != 'nb'>>$args[0]<<else>>$args[1]<</if>><</widget>>
<<widget slaveEvents>>
    <<set _eventSlaves = window[_args[0]].getEventSlaves()>>
    <<set _eventIndex to 0>>
    <<include slaveEvent>><<if _eventSlaves.length>><br><</if>>
<</widget>>
<<widget showCookFeedingRules>>
    <<dialog "Cook feeding rules">>
        <label><input type="checkbox" id="feedEnabled">Feed all the slaves that have at least </label><input type="number" id="feedAtHunger" style="width:3em" min="1" max="100">hunger.<br>
        Those slaves will be fed at 7AM, 1PM and 7PM<br>
        <div class="row">
            <div class="one-half column">
                Special cases:<br>
                <span id="exceptionList"><<include cookFeedExceptions>></span>
                <br><button id="addExceptionBtn">Add exception</button>
            </div><div class="one-half column" id="exceptionEditor"></div>
        </div>
        <<done>><<run
            Player.bindSettingDom('feedEnabled',$settings.cook,'feedEnabled');
            Player.bindSettingDom('feedAtHunger',$settings.cook,'feedAtHunger');
            $('#addExceptionBtn').on('click',function(){
                var exceptionEditor = $('#exceptionEditor').html('<h3>New exception</h3>\
                    Slave:\
                    <select id="exceptionSlaveSelect" style="width:100%"></select>\
                    <label><input type="checkbox" id="exceptionFeedEnabled" checked>Feed this the slave when they have at least </label><input type="number" id="exceptionFeedAtHunger" style="width:3em" min="1" max="100" value="20">hunger.\
                    <br><button id="saveExceptionBtn">Save</button>');
                var exceptionSlaveSelect = $('#exceptionSlaveSelect').select2({
                    placeholder:"Select slave...",
                    dropdownParent:exceptionEditor,
                    data:$slaves.filter(function(slave) {
                        return !$settings.cook.exceptions.find(function(ex){ return ex.npc == slave.uid; });
                    }).map(function(slave){return {
                        id: slave.uid,
                        text: Person.getShortDescription(slave, true)
                    }})
                }).val(null).trigger('change');
                $('#saveExceptionBtn').on('click',function(){
                    var slaveId=exceptionSlaveSelect.val();
                    if(!slaveId)return;
                    $settings.cook.exceptions.push({
                        npc:slaveId,
                        feedEnabled:$('#exceptionFeedEnabled').is(':checked'),
                        feedAtHunger:$('#exceptionFeedAtHunger').val()
                    });
                    exceptionEditor.html('');
                    $('#exceptionList').html('').wiki('<<include cookFeedExceptions>>');
                });
            });
        >><</done>>
    <</dialog>>
<</widget>>
:: workOption {"position":"875,0"}
<<if $player.job && !$player.workedToday && Now.isBetween("7:00 AM", "2:00 PM")>>\
    <<workOption>>
<</if>>\
