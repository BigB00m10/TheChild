:: kitchen {"position":"900,625"}
<<scenery kitchen>>
<<if $settings.cook && $settings.cook.npc>><<set _cook=Person.get($settings.cook.npc)>><</if>>\
You are currently standing in your kitchen.<<if _cook>> _cook.name is in charge of cooking.<</if>>
<<unlessEmergency>>\
    <<wanderingSlaves>>\
    <<slaveEvents Kitchen>>
    <<keyOption [[Leave the kitchen|main]] 🚪>>
    <<keyAction 'Have a meal' ☕>>
        <<addMinutes 45>>
        <<set $player.energy = ($player.energy + 18).clamp(0, 100)>>
        <<run Engine.show()>>
    <</keyAction>>: 45min + 18 Energy
    <<homeSpaceContainerOption 'Kitchen' 'cabinet'>>\
    <<if _cook>>\
        <<keyAction 'Set feeding rules' ⚙>>
            <<showCookFeedingRules>>
        <</keyAction>>
    <</if>>\
    <<sleepOption>>\
<</unlessEmergency>>\