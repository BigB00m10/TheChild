:: scenery [widget] {"position":"1125,0"}
<<widget scenery>>\
    <<nobr>>\
        <<set _base64 to null;$scenery to _args[0]>>
        <<switch $scenery>>
            <<case dump>>
                <<set _base64 to "">>
            <<case playground>>
                <<set _base64 to "">>
            <<case bed>>
                <<set _base64 to "">>
            <<case mainRoom>>
                <<set _base64 to "">>
            <<case basement>>
                <<set _base64 to "">>
            <<case home>>
                <<set _base64 to "">>
            <<case bathroom>>
                <<set _base64 to "">>
            <<case wc>>
                <<set _base64 to "">>
            <<case garden>>
                <<set _base64 to "">>
            <<case shool>>
                <<set _base64 to "">>
            <<case pc>>
                <<set _base64 to "">>
            <<case kitchen>>
                <<set _base64 to "data:image/jpeg;base64,">>
            <<case cumstop>>
                <<set _base64 to "">>
            <<case deepweb>>
                <<set _base64 to "">>
        <</switch>>
    <</nobr>>\
    <<if _base64 != null && !$settings.hideScenery>>\
        <<set _base64 to "data:image/jpeg;base64," + _base64>>\
        <img class="centerHouse" @src="_base64"><<unset _base64>>
        <hr>
    <</if>>\
<</widget>>\
:: imageConvert [nobr]
<div id="dropImage" style="outline:2px dashed gray;outline-offset:-10px;width:100%;padding:3em 0;text-align: center">
    <p>Drag an image file here</p>
</div>
Base64 data url:<button id="btnCpyB64">Copy</button><span id="resultCpyB64"></span>
<textarea id="b64Out" rows="8" style="width:100%"></textarea>
Javascript string output:<button id="btnCpyJsStr">Copy</button><span id="resultCpyJsStr"></span>
<textarea id="jsStrOut" rows="8" style="width:100%"></textarea>
<script>
    $('#dropImage').on('drag dragstart dragend dragover dragenter dragleave drop',(e)=>{
        e.preventDefault();
        e.stopPropagation();
    }).on('drop',(e)=>{
        const file = e.originalEvent.dataTransfer.files[0];
        const jsReader = new FileReader();
        jsReader.onload = ()=>$('#jsStrOut').val(LZString.compressToUTF16(jsReader.result).replaceAll('`','${bt}'));
        jsReader.readAsBinaryString(file);
        const b64reader = new FileReader();
        b64reader.onload = ()=>$('#b64Out').val(b64reader.result);
        b64reader.readAsDataURL(file);
    });
    const copyTextareaToClipboard=(idTextarea,idResult)=>{
        const $textarea = $('#'+idTextarea);
        const $result = $('#'+idResult);
        const nowStr = new Date().toLocaleTimeString();
        const setSuccess = ()=>$result.html(`👍🏻 Copy successful (${nowStr})`);
        const setFailed = ()=>$result.html(`👎🏻 Copy failed!! (${nowStr})`);
        if(navigator.clipboard){
            navigator.clipboard.writeText($textarea.val()).then(setSuccess,setFailed);
            return;
        }
        $textarea[0].focus();
        $textarea[0].select();
        try {
            if(document.execCommand('copy')) setSuccess();
            else setFailed();
        } catch (ex) {
            setFailed();
        }
    };
    $('#btnCpyJsStr').on('click',()=>copyTextareaToClipboard('jsStrOut', 'resultCpyJsStr'));
    $('#btnCpyB64').on('click',()=>copyTextareaToClipboard('b64Out', 'resultCpyB64'));
</script>
