:: widgets [widget nobr]
<<widget emoji>><<if $settings.emoji === false>><<set _style to "display:none">><</if>><span class='emoji' @style="_style">_args[0]</span><</widget>>
<<widget addMinutes>>
    <<run Now.addMinutes(_args[0])>>
<</widget>>
<<widget addHours>>
    <<run Now.addHours(_args[0])>>
<</widget>>
<<widget cash>>
    <<run $player.cash = Math.round(($player.cash + _args[0]) * 100) / 100
        ;_cashAction = _args[0] < 1 ? 'lost' : 'received'
        ;_cashColor = _args[0] < 1 ? 'red' : 'green'>>
    @@color:_cashColor;You _cashAction ¤<<- _args[0].toFixed(2)>>@@
<</widget>>
<<widget workOption>>
    <<set _workEmoji = $player.gender != "male" ? "👷‍♀️" : "👷‍♂️"; _workText = "Go to work" + (Now.isWeekend()?" (Optional)":"")>>
    <<keyOption _workText work _workEmoji>>
<</widget>>
<<widget sleep>>
    <<set $player.sleeping = true;
        Now.skipTo("7:00 AM")>>
    <<goto bed>>
<</widget>>
<<widget unlessEmergency container>>
    <<if $player.energy lt 1>>
        @@color:red;You REALLY need to sleep@@<br>
        <<keyAction 'Go to sleep' 😴>><<sleep>><</keyAction>>
    <<else>>
        <<if $player.job && !Now.isWeekend() && !$player.workedToday && Now.isEqualOrLaterThan($player.job.enterTime)>>
            @@color:red;You need to go to work@@<br>
            <<workOption>>
        <<else>>
            _contents
        <</if>>
    <</if>>
<</widget>>
<<widget checkNpcVirgin>>
    <<set _fieldName to _args[0] + 'Virgin'>>
    <<if $npc[_fieldName]>>
        <<set $npc[_fieldName] to false>>
        <<if $npc.index != undefined>>
            <<set $slaves[$npc.index][_fieldName] to false>>
        <</if>>
        @@color:red;$npc.name just lost $npc.possessive _args[0] virginity!!!@@<br>
    <</if>>
<</widget>>
<<widget userEditListVar>>
    <<run console.info(_args)>>
    <<set _list = eval(_args[0]).join('\n')>>
    <<dialog _args[1]>>
        <<textarea "_newList" _list>><br>
        <<button "✅ Save">>
            <<run eval(_args[0] + '=' + JSON.stringify(_newList.split(/\r?\n/)));Dialog.close()>>
        <</button>>
        <span id="escAct">
            <<button "❌ (Esc) Cancel">>
                <<run Dialog.close()>>
            <</button>>
        </span>
    <</dialog>>
<</widget>>
<<widget npcAddressPlayer>><<- Player.getAddressing($npc)>><</widget>>
:: workOption
<<if $player.job && !$player.workedToday && Now.isBetween("7:00 AM", "2:00 PM")>>\
    <<workOption>>
<</if>>\