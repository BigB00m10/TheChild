:: StoryCaption {"position":"250,0"}
----
<<- Now.getDateString()>>
!<<- Now.getWeekDay()>>
!!!<<- Now.getTime()>>
----
$player.name <<link "[Inventory]">><<dialog "Player Inventory">>\
    <<set _items = Player.getInventory().items>>\
    <<for _item range _items>>\
        <<print OnlineStore.getInventoryLine(_item)>>
    <</for>>\
    <<set _items = Player.getEquippedInventory().withoutDescription('npc')>>\
    <<if _items.length>><h3>Worn Items:</h3>\
        <<for _item range _items>>\
            <<print OnlineStore.getWornInventoryLine(_item)>>
        <</for>>\
    <</if>>\
    <<set _items = Player.getEquippedInventory().withDescription('npc')>>
    <<if _items.length>><h3>Holding NPCs:</h3>\
        <<for _item range _items>>\
            <<set _npc = Person.get(_item.extra)>><<capture _npc>>
            <<- Person.getShortDescription(_npc)>><<button interact>>\
                <<run console.info(_npc)>>
                <<openNpcInteraction slave _npc>>\
                <<dialogclose>>\
            <</button>><<button 'put down'>>\
                <<if passage() == 'npcInteraction'>>
                    <<dialog 'Put NPC down'>>\
                        You cannot put an NPC down during an interaction.
                        <<button OK>><<dialogclose>><</button>>
                    <</dialog>>\
                <<elseif !Player.isHome()>>\
                    <<dialog 'Put NPC down'>>\
                        You need to be home to be able to put an NPC down.
                        <<button OK>><<dialogclose>><</button>>
                    <</dialog>>\
                <<elseif $scenery == 'basement'>>\
                    <<if _npc.status == 'servant'>>\
                        <<dialog 'Put NPC down'>>\
                            $npc.name is your servant so you cannot put $npc.pronoun down in the basement.
                            $npc.GenPronoun will not be able to serve you while locked in the basement.
                            <<button OK>><<dialogclose>><</button>>
                        <</dialog>>\
                    <<else>>\
                        <<dialog 'Put NPC down'>>\
                            You put _npc.name down into the basement.
                            <<button OK>><<dialogclose>><</button>>
                        <</dialog>><<run
                            Person.setStatus('slave', _npc);
                            Player.getEquippedInventory().removeNpc(_npc);
                            Player.lactationTimeout($player);
                            Engine.show();
                        >>\
                    <</if>>\
                <<else>>\
                    <<if _npc.freedomWish gt 25 && !Person.hasAchievement('beenOnHomeMain', _npc)>>\
                        <<dialog 'Put NPC down'>>\
                            You cannot let _npc.name free outside of the basement because _npc.possessive freedom wish is _npc.freedomWish and cannot be higher than 25.
                            <<button OK>><<dialogclose>><</button>>
                        <</dialog>>\
                    <<else>>\
                        <<dialog 'Put NPC down'>>\
                            You let _npc.name down. Now _npc.genPronoun<<thirdPerson "'s" "'re" _npc.uid>> free to roam around the house.
                            <<if $npc.love lt 60 && $npc.age gte 1 && !Person.hasAchievement('beenOnHomeMain', _npc)>>\
                                The taste of a little more freedom makes _npc.name wanting it even more.
                            <</if>>\
                            <<button OK>><<dialogclose>><</button>>
                        <</dialog>><<run
                            Person.setAchievement('beenOnHomeMain', _npc);
                            Person.setStatus('home slave', _npc, $scenery);
                            if(_npc.love < 60 && _npc.age > 1 && !Person.hasAchievement('beenOnHomeMain', _npc))
                                _npc.freedomWish += Math.floor(Math.min((_npc.age * 25) / 6, 25))
                            Player.getEquippedInventory().removeNpc(_npc);
                            Player.lactationTimeout($player);
                            Engine.show();
                        >>\
                    <</if>>\
                <</if>>
            <</button>>
        <</capture>><</for>>\
    <</if>><<unset _items>>\
<</dialog>><</link>>
<<if $cheat>>\
    <<link "+10k">>\
        <<set $player.cash += 10000;Engine.show()>>
    <</link>> \
    <<link "+100k">>\
        <<set $player.cash += 100000;Engine.show()>>
    <</link>> \
<</if>>\
Cash: ¤<<- $player.cash.toFixed(2)>>
<<if $cheat>>\
    <<link "+">>\
        <<set $player.energy = 100;Engine.show()>>
    <</link>> \
<</if>>\
Energy:<<if $cheat>>\
<<set _infiniteEnergyText = "Make " + ($settings.infiniteEnergy ? "Finite" : "Infinite")>>\
 <span id="infiniteEnergy"><<link _infiniteEnergyText>><<set
    $settings.infiniteEnergy = ~$settings.infiniteEnergy;
    $('#infiniteEnergy a').html("Make " + ($settings.infiniteEnergy ? "Finite" : "Infinite"));
>><</link>></span><</if>>
<<showmeter playerEnergy `$player.energy / 100`>>
:: StoryMenu {"position":"1025,125"}
<<link "👨‍👩‍👧‍👦 Character stats">>
    <<dialog "Character stats">>
        <<set _dialogWidth = 'width:' + Math.min(1022, window.innerWidth - 84) + 'px'>>\
        <div class="row" @style=_dialogWidth>\
            <div class="eight columns" id="stats"><br></div>\
            <div class="four columns">\
                <<for _npc range Person.all()>>\
                    <<set _action to "<<replace #stats>><<personProperties " + _npc.uid + ">><</replace>>">>\
                    <<printPersonLink _npc _action>><<unset _action>>
                <</for>>\
            </div>\
        </div>\
    <</dialog>>
<</link>>
<<link "⚙ Settings">><<include settings>><</link>>
<<link "🙏 Credits">><<dialog "Credits">>\
    <<set _credits={
        MysticalMagic:'Original Idea',
        stuffed:'Coding and writting',
        Osgilio26:'Coding, art and design',
        DocAmakus:'Coding',
        JoaxOuch:'Coding, art and design',
        SirDerpington:'Coding',
        Pain:'Writting',
        Arganderus:'Writting',
        samandsteve:'Coding, writting and design',
        StrangeFriend:'Art',
        Astrii:'Writting',
        Carrabina:'Coding and writting'
    };
    let width = window.innerWidth - 84;
    _nameStyle = "";
    if(width > 415){
        width = 415;
        _nameStyle = "text-align:right"
    }
    _dialogWidth = 'width:' + Math.min(415, window.innerWidth - 84) + 'px';>>\
    <div @style=_dialogWidth>\
        <<for _name, _role range _credits>>\
            <div class="row">\
                <div class="one-half column" @style="_nameStyle">''_name''<<if !_nameStyle>>:<</if>></div><div class="one-half column">_role</div>\
            </div>\
        <</for>>\
    </div>\
<</dialog>><</link>>
:: settings {"position":"500,125"}
<<dialog Settings>>\
    <<set _stopAgingNpcs=Person.all(function(npc){return npc.stopAging})>>\
    <style>.addressing{width: 6em;min-width: 0 !important}h3{color:yellow}</style>\
    <div class="tabs">\
        <input type="radio" name="configTabs" id="tab-childGen" checked>\
        <label for="tab-childGen">Child generator</label>\
        <div>\
            <div class="row">\
                <div class="four columns">\
                    Female percentage:\
                    <div class="slidecontainer">\
                        <div style="display:inline-block"><input type="range" min="0" max="100" value="50" class="slider" id="femalePercentSlider"></div>\
                        <div style="display:inline-block;position: relative;top: -11px;">\
                        <input id="femalePercentDisplay" @value="$settings.childGeneration.femalePercentage" style="width: 1.7em;border: 0;pointer-events: none;" readonly> %</div>\
                    </div>\
                </div>\
                <div class="eight columns">\
                    Herm percentage (100 is all characters replaced with herms):\
                    <div class="slidecontainer">\
                        <div style="display:inline-block"><input type="range" min="0" max="100" value="50" class="slider" id="hermPercentSlider"></div>\
                        <div style="display:inline-block;position: relative;top: -11px;">\
                        <input id="hermPercentDisplay" @value="$settings.childGeneration.hermPercentage" style="width: 1.7em;border: 0;pointer-events: none;" readonly> %</div>\
                    </div>\
                </div>\
            </div>\
            <div class="row">\
                <div class="one-third column">\
                    Females:
                    <label>From<input type="number" min="0" id="femaleAgeFrom" style="width:3em">years old</label>
                    <label>To &nbsp;<input type="number" id="femaleAgeTo" style="width:3em">years old</label>
                </div>\
                <div class="one-third column">\
                    Males:
                    <label>From<input type="number" min="0" id="maleAgeFrom" style="width:3em">years old</label>
                    <label>To &nbsp;<input type="number" id="maleAgeTo" style="width:3em">years old</label>
                </div>\
                <div class="one-third column">\
                    Herms:
                    <label>From<input type="number" min="0" id="hermAgeFrom" style="width:3em">years old</label>
                    <label>To &nbsp;<input type="number" id="hermAgeTo" style="width:3em">years old</label>
                </div>\
            </div>\
            <<button "Hair colors">>\
                <<userEditListVar "$settings.childGeneration.hairColors" "Edit hair colors" PersonGeneration.hairColors>>
            <</button>>\
            <<button "Hair styles">>\
                <<userEditListVar "$settings.childGeneration.hairStyles" "Edit hair styles" PersonGeneration.hairStyles>>
            <</button>>\
            <<button "Eye colors">>\
                <<userEditListVar "$settings.childGeneration.eyeColors" "Edit eye colors" PersonGeneration.eyeColors>>
            <</button>>\
            <<button "Skins">>\
                <<userEditListVar "$settings.childGeneration.skins" "Edit skins" PersonGeneration.skins>>
            <</button>>\
        </div>\
        <input type="radio" name="configTabs" id="tab-tweaks">\
        <label for="tab-tweaks">Tweaks</label>\
        <div>\
            <div class="row">\
                <div class="one-half column">\
                    <h3>Change job</h3>\
                    Current job: <<- $player.job ? $player.job.name.toUpperFirst() : "Unemployed">>
                    <<for _jobKey, _job range Jobs>>\
                        <<set _jobDesc = _job.name.toUpperFirst() + ": Pay:¤" + _job.pay.toFixed(2) + "/day, Go time:" + _job.enterTime>>\
                        <<print '<<button _jobDesc>><<run $player.job = ' + JSON.stringify(_job) + ';Engine.show()>><<dialog "Job changed">>Your job is now: ' + _job.name.toUpperFirst() + '.<</dialog>><</button>>'>>
                    <</for>>\
                    <<button '<<emoji 🚫>>None'>><<run $player.job = null;Engine.show()>><<dialog "Job changed">>You're now unemployed.<</dialog>><</button>>\
                </div><div class="one-half column">\
                    <div class="row">\
                        <h3>Lust drop</h3>\
                        <label>Amount of lust drop after NPC ejaculating: <input type="number" id="lustDecCum" style="width:3em"></label>
                    </div><div class="row">\
                        <h3>Pregnancy duration</h3>\
                        <label><input type="radio" name="pregnancyOption" value="months">Months: <input type="number" id="pregnancyMonths" value=9 style="width:2em" min=1 max=99></label>
                        <label><input type="radio" name="pregnancyOption" value="days">Days: <input type="number" id="pregnancyDays" value=9 style="width:2em" min=1 max=99></label>
                        <label><input type="radio" name="pregnancyOption" value="disabled">Disable impregnation.</label>
                    </div>\
                </div>\
            </div><div class="row">\
                <div class="one-half column">\
                    <h3>Addressing</h3>\
                    How should your kids call you? (leaving them blank reverts them to default value)
                    Slaves: <input type="text" class="addressing" data-target="slave">
                    Servants: <input type="text" class="addressing" data-target="servant">(Cook)
                    Lovers: <input type="text" class="addressing" data-target="lover">(Unused for now)
                    Your Sons/Daughters: <input type="text" class="addressing" data-target="offspring">
                </div><div class="one-half column">\
                    <h3>NPC Aging</h3>\
                    How much time do characters need to age up.
                    <label><input type="radio" name="agingOption" value=365.25>Real in-game time (1 in-game year to age 1 year)</label>
                    <label><input type="radio" name="agingOption" value=12>Age up in <input type="number" id="agingIgDays" value=12 style="with:3em" min=1 max=999> days.</label>
                    <label><input type="radio" name="agingOption" value=0>Disabled (Nobody ages).</label>
                    Stop aging of these NPCs: <<- _stopAgingNpcs.map(function(npc){return npc.name}).getSentence()>> <<button Modify>>
                        <<dialog "Non-aging NPCs">>\
                            <style>@media(min-width:714px){#nonAgingNpcContent{min-width:665px}}</style>\
                            <<set 
                                _updateNonAgingNpcSelect = function() {
                                    _nonAgingNpcSelect.empty().select2({
                                        placeholder:"Select NPC...",
                                        dropdownParent:$('#npcSelector'),
                                        data:Person.all(function(npc){
                                            return !npc.stopAging;
                                        }).map(function(npc){return {
                                            id: npc.uid,
                                            text: Person.getShortDescription(npc, true)/*TODO: might not be a person in the future*/
                                        }})
                                    }).val(null).trigger('change');
                                };
                                _removeNonAgingNpc = function(uid) {
                                    Person.get(uid).stopAging = false;
                                    $('#nonAging' + uid).remove();
                                    _updateNonAgingNpcSelect();
                                };
                            >>
                            <div class="row" id="nonAgingNpcContent">\
                                <div class="one-half column" id="nonAgingList">\
                                    <<for _npc range _stopAgingNpcs>><<capture _npc>>\
                                        <<set _nonAgingNpcId='nonAging'+_npc.uid>>\
                                        <span @id="_nonAgingNpcId"><<- Person.getShortDescription(_npc)>><<button Remove>>
                                            <<run _removeNonAgingNpc(_npc.uid)>>
                                        <</button>>
                                    </span><</capture>><</for>>\
                                </div><div class="one-half column" id="npcSelector">\
                                    NPCs:
                                    <select id="nonAgingNpcSelect" style="width:100%"></select>\
                                    <button id="addNonAgingNpcBtn">Add to list</button>
                                </div>\
                            </div>
                            <<button 'Return to settings'>><<include settings>><</button>>
                            <<done>><<run
                                _nonAgingNpcSelect = $('#nonAgingNpcSelect');
                                _updateNonAgingNpcSelect();
                                $('#addNonAgingNpcBtn').on('click', function(){
                                    var uid = $('#nonAgingNpcSelect').val();
                                    var npc = Person.get(uid);
                                    npc.stopAging = true;
                                    $('#nonAgingList').append($('<span id="nonAging' + uid + '">').wiki(Person.getShortDescription(npc) + '<<button Remove>><<run _removeNonAgingNpc(' + uid + ')>><</button>><br>'));
                                    _updateNonAgingNpcSelect();
                                });
                            >><</done>>
                        <</dialog>>
                    <</button>>
                </div>\
            </div>\
        </div>\
        <input type="radio" name="configTabs" id="tab-switches">\
        <label for="tab-switches">Switches</label>\
        <div>\
            <label class="toggle-button">\
                <input id="toggleEmoji" type="checkbox" class="macro-checkbox"><span>Show emojis</span>\
            </label>\
            <label class="toggle-button">\
                <input id="toggleAnal" type="checkbox" class="macro-checkbox"><span>Show anal content</span>\
            </label>\
            <label class="toggle-button">\
                <input id="toggleSlaveSell" type="checkbox" class="macro-checkbox"><span>Slave selling</span>\
            </label>\
            <<set _cheatButtonText = ($cheat ? "Disable" : "Enable") + " Cheats">>\
            <span id='cheatsButton'><<button _cheatButtonText>>\
                <<run
                    $cheat ^= 1;/*Xor inverse $cheat value. Undefined or 0 becomes 1 (true) and 1 becomes 0*/
                    Engine.show();
                    $('#cheatsButton button').text(($cheat ? "Disable" : "Enable") + " Cheats");
                >>
            <</button>></span>\
        </div>\
    </div>\
    <script>
        var $variables = SugarCube.State.variables
        var $settings = $variables.settings
        var agingOptions = $('input[name=agingOption]');
        var agingIgDaysInput = $('#agingIgDays');
        switch($settings.agingIgDays){
            case undefined:
            case 365.25:
                agingOptions[0].checked=true;
                break;
            case 0:
                agingOptions[2].checked=true;
                break;
            default:
                agingOptions[1].checked=true;
                agingIgDaysInput.val($settings.agingIgDays);
                break;
        }
        agingOptions.on('change', function(){
            $settings.agingIgDays = parseFloat($('input[name=agingOption]:checked').val());
        });
        agingIgDaysInput.on('input blur', function(){
            agingOptions[1].checked = true;
            $settings.agingIgDays = parseFloat(agingOptions[1].value = agingIgDaysInput.val());
        });
        var pregnancyOptions = $('input[name=pregnancyOption]')
        var pregnancyMonthsInput = $('#pregnancyMonths')
        var pregnancyDaysInput = $('#pregnancyDays')
        switch($settings.pregnancyOption){
            case undefined:
            case 'months':
                pregnancyOptions[0].checked=true
                if($settings.pregnancyDays)
                    pregnancyMonthsInput.val(Math.round($settings.pregnancyDays/30))
                break
            case 'days':
                pregnancyOptions[1].checked=true
                if($settings.pregnancyDays)
                    pregnancyDaysInput.val($settings.pregnancyDays)
                break
            default:
                pregnancyOptions[2].checked=true
                break
        }
        pregnancyOptions.on('change',function(){
            $settings.pregnancyOption = $('input[name=pregnancyOption]:checked').val()
            switch($settings.pregnancyOption){
                case 'months':
                    $settings.pregnancyDays = parseInt(pregnancyMonthsInput.val())*30
                    break
                case 'days':
                    $settings.pregnancyDays = parseInt(pregnancyDaysInput.val())
                    break
            }
        })
        pregnancyMonthsInput.on('input blur',function(){
            pregnancyOptions[0].checked=true
            pregnancyOptions.trigger('change')
        })
        pregnancyDaysInput.on('input blur',function(){
            pregnancyOptions[1].checked=true
            pregnancyOptions.trigger('change')
        })
        var defaultOffspringAddr = $variables.player.gender != 'male' ? 'mommy' : 'daddy'
        var addrUpdateValue = function(element){
            var addrDefault = $settings.addressing.slave ? $settings.addressing.slave : $variables.player.name
            switch (element.dataset.target) {
                case 'slave':
                    element.value = addrDefault
                    break
                case 'servant':
                    element.value = $settings.addressing.servant ? $settings.addressing.servant : addrDefault
                    break
                case 'lover':
                    element.value = $settings.addressing.lover ? $settings.addressing.lover : addrDefault
                    break
                case 'offspring':
                    element.value = $settings.addressing.offspring ? $settings.addressing.offspring : defaultOffspringAddr
                    break
            }
        }
        if($settings.addressing)
            $('.addressing').each(function() {addrUpdateValue(this)})
        else {
            $('.addressing:not([data-target="offspring"])').val($variables.player.name)
            $('.addressing[data-target="offspring"]').val(defaultOffspringAddr)
        }
        $('.addressing').on('input blur', function() {
            var value = this.value.trim()
            if(!$settings.addressing)
                $settings.addressing = {}
            switch (this.dataset.target) {
                case 'slave':
                    $settings.addressing.slave = value
                    $('.addressing:not([data-target="offspring"]):not([data-target="slave"])').each(function() {addrUpdateValue(this)})
                    break
                case 'servant':
                    $settings.addressing.servant = value
                    break
                case 'lover':
                    $settings.addressing.lover = value
                    break
                case 'offspring':
                    $settings.addressing.offspring = value
                    break
            }
        })
        Player.bindSettingDom('toggleEmoji',$settings,'emoji',function(element){
            var $emoji = $('.emoji')
            if(element.checked)
                $emoji.show()
            else
                $emoji.hide()
        })
        Player.bindSettingDom('toggleAnal',$settings,'anal')
        Player.bindSettingDom('toggleSlaveSell',$settings,'slaveSelling')
        Player.bindSettingDom('femalePercentSlider',$settings.childGeneration,'femalePercentage',null,'femalePercentDisplay')
        Player.bindSettingDom('hermPercentSlider',$settings.childGeneration,'hermPercentage',null,'hermPercentDisplay')
        Player.bindRangeSettingsDom('femaleAge',$settings.childGeneration.females,'age')
        Player.bindRangeSettingsDom('maleAge',$settings.childGeneration.males,'age')
        Player.bindRangeSettingsDom('hermAge',$settings.childGeneration.herms,'age')
        Player.bindSettingDom('lustDecCum',$settings,'lustDecCum')
    </script>\
<</dialog>>\
:: noAgingNpcList [nobr] {"position":"375,125"}
<<if $settings.cook.exceptions.length>>
    <<for _exception range $settings.cook.exceptions>>
        <<set _exceptionPerson = Person.get(_exception.npc)>>
        <span class="exceptionPerson" @data-exception-npc="_exception.npc"><<printPersonLink _exceptionPerson ''>></span><br>
    <</for>>
    <<done>><<run >><</done>>
<<else>>
    (none)<br>
<</if>>