:: bed {"position":"675,825"}
<<scenery bed>>
<<if $player.sleeping>>\
    <<set _sleepSlave = $slaves.firstOrDefault(function(slave){return Person.hasAchievement('okSleepWithPlayer', slave)})>>\
    <<if _sleepSlave>><<done>>/*Without using the done macro the bed passage was executed twice for some reason*/
        <<run State.history.splice(State.history.length - 1, 1)>>/*Let's forget that we entered the bed scene so that the player can still go back in time. Otherwise they would be redirected back to the interaction.*/
        <<openNpcInteraction wakeUpAfterNightTogether _sleepSlave.uid>>
    <</done>><</if>>
	As the sun reveals the world to a nice <<- Now.getWeekDay()>> morning, you climb out of bed, ready to start a new day. <<- either("The birds chip happily in the morning sun and the trees rustle alive in the early breeze.", "The morning sun shines through your room, illuminating it in a nice warm glow.")>>
<<else>>\
	You currently stand in the middle of your cozy small bedroom.
<</if>>\
<<if $player.sleeping && OnlineStore.pendingOrder()>>
    Someone is knocking at the front door!!
    Who might that be?
    <<keyOption [[Go check|receivePacket]] 🚪>>
<<else>>
    <<unlessEmergency>>\
        <<wanderingSlaves>>\
        <<slaveDemands BedRoom>>
        <<keyOption [[Leave your room|main]] 🚪>>
        <<keyOption [[go to your computer|pc]] 💻>>
        <<keyOption [[Your bathroom|bathroom]] 🛀>>
        <<sleepOption>>
    <</unlessEmergency>>\
<</if>>
<<set $player.sleeping = false>>
<<unset $personWokeUp>>
:: main {"position":"600,625"}
<<scenery mainRoom>>
You are currently standing in the middle of the main room of your house.

''Is there something you want to do in here?''

<<unlessEmergency>>\
    <<wanderingSlaves>>\
    <<slaveDemands MainRoom>>
    <<keyOption [[Watch TV|watchTv]] 📺>>: 30min
    <<include workOption>>\
    <<keyOption [[Go outside|home]] 🚪>>
    <<keyOption [[The Basement|basement]] 🔒>>
    <<keyOption [[Your Bedroom|bed]] 🛌>>
    <<keyOption [[Your garden|garden]] 🌺>>
    <<keyOption [[Your kitchen|kitchen]] ☕>>
    <<keyOption [[Your toilet|wc]] 🚽>>
    <<keyOption [[Your bathroom|bathroom]] 🛀>>
<</unlessEmergency>>\
:: watchTv {"position":"875,825"}
<<addMinutes 30>>\
@@color:yellow;You spend the next half hour skimming through channels and shows.@@
<<include main>>\
:: watchPorn {"position":"700,950"}
<<addMinutes 30>>\
@@color:yellow;You spend the next half hour skimming through porn and <<if $player.gender == 'girl'>>buffing the muffin<<else>>jerking off<</if>>.@@
<<include bed>>\
:: slaveDemand {"position":"375,0"}
<<if _demandingSlaves[_demandIndex]>>\
    <span id="slaveDemand">\
        <<set _slave to _demandingSlaves[_demandIndex]>>
        _slave.name <<if _slave.fear gte 30>>cautiously<</if>> approaches, looking at you with _slave.possessive _slave.eyeColor eyes, and says:
        "<<switch _slave.need>>\
/*        */<<case "hunger">>\
/*          */<<if _slave.hunger gte 75>>\
/*            */<<if _slave.age gte 5>>Please!!! I'm so hungry!!! <<emoji 🙁>><<else>>I'm hungryyyyyy!!! <<emoji 😢>><</if>>\
/*          */<<else>>\
/*            */I'm hungry... <<emoji 🙁>>\
/*          */<</if>>\
/*        */<<case 'sleepWithPlayer'>>\
/*          */Hey <<npcAddressPlayer _slave>>, can I sleep in the same bed as you tonight?\
/*        */<<case 'cook'>>\
/*          */_slave.name is currently cooking.\
/*      */<</switch>>"
        <<set _demandInteraction to "slaveDemand" + _slave.need.toUpperFirst()>>
        <span id='hKeyAct'>\
            <<button '✅ (H) Handle'>>
                <<set $npc to _demandingSlaves[_demandIndex]>>
                <<openNpcInteraction _demandInteraction>>
            <</button>>\
        </span><span id='iKeyAct'>\
            <<button '❌ (I) Ignore'>>\
                <<set _demandIndex++>>
                <<replace #slaveDemand>><<include slaveDemand>><</replace>>
            <</button>>\
        </span>\
    </span>\
<</if>>\
:: cookFeedExceptions [nobr]
<<if $settings.cook.exceptions.length>>
    <<for _exception range $settings.cook.exceptions>>
        <<set _exceptionPerson = Person.get(_exception.npc)>>
        <span class="exceptionPerson" @data-exception-npc="_exception.npc"><<printPersonLink _exceptionPerson ''>></span><br>
    <</for>>
    <<done>><<run $('.exceptionPerson').on('click',function(){
        var exceptionNpc = $(this).data('exception-npc');
        var exceptionEditor = $('#exceptionEditor').html('<h3>Edit exception</h3>\
            Slave:' + Person.getShortDescription(Person.get(exceptionNpc), true) + '<br>\
            <label><input type="checkbox" id="exceptionFeedEnabled">Feed this the slave when they have at least </label><input type="number" id="exceptionFeedAtHunger" style="width:3em" min="1" max="100">hunger.\
            <br><button id="deleteExceptionBtn">Delete</button>');
        var exceptionIndex = $settings.cook.exceptions.findIndex(function(ex){return ex.npc == exceptionNpc});
        Player.bindSettingDom('exceptionFeedEnabled',$settings.cook.exceptions[exceptionIndex],'feedEnabled');
        Player.bindSettingDom('exceptionFeedAtHunger',$settings.cook.exceptions[exceptionIndex],'feedAtHunger');
        $('#deleteExceptionBtn').on('click',function(){
            exceptionEditor.html('');
            $settings.cook.exceptions.splice(exceptionIndex, 1);
            $('#exceptionList').html('').wiki('<<include cookFeedExceptions>>');
        });
    })>><</done>>
<<else>>
    (none)<br>
<</if>>