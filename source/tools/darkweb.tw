:: DarkStore {"position":"675,950"}
<<scenery deepweb>>
<<unlessEmergency>>\
    <<keyOption [[Buy a child|DarkStore]] 🧑‍💻>>
    <<keyOption [[Buy torture object|DarkStore]] ⛓️>>
    <<keyOption [[Buy a vehicle|DarkStore]] 🚗>>
    <<keyOption [[Sell a child|sellchild]] 💸>>
    <<keyOption [[Sell a dirty clothes|sellclothes]] 👙>>
    <<keyOption [[Leave your dark web|pc]] 💻>>
<</unlessEmergency>>\

:: sellchild {"position":"575,1100"}
<<set _dialogTitle = "$npc.name + 's value">>
    <<dialog _dialogTitle>>
        <span id="escAct">\
            <<button "✅ Yes, sell $npc.pronoun">>
                <<cash _value.total>>
                <<goto DarkStore>>
                <</button>>\
            <<button "🔙 (Esc) Go back">>\
            <<run Dialog.close()>>\
            <</button>>\
        </span>\
    <</dialog>>
    <<include DarkStore>>

:: sellclothes {"position":"700,1100"}
    <<set _dialogTitle = "Sell dirty clothes">>
    <<dialog _dialogTitle>>
        <span id="escAct">\
            <<button "✅ Yes, sell $npc.pronoun">>
                <<cash _value.total>>
                <<goto DarkStore>>
                <</button>>\
            <<button "❌ (Esc) No!!">>\
            <<run Dialog.close()>>\
            <</button>>\
        </span>\
    <</dialog>>
    <<include DarkStore>>

