:: StoryCaption {"position":"250,0"}
----
!<<- Now.getWeekDay()>>
!!!<<- Now.getTime()>>
----
$player.name
<<if $cheat>>\
    <<link "+10k">>\
        <<set $player.cash += 10000;Engine.show()>>
    <</link>> \
    <<link "+100k">>\
        <<set $player.cash += 100000;Engine.show()>>
    <</link>> \
<</if>>\
Cash: ¤<<- $player.cash.toFixed(2)>>
<<if $cheat>>\
    <<link "+">>\
        <<set $player.energy = 100;Engine.show()>>
    <</link>> \
<</if>>\
Energy:<<if $cheat>>\
<<set _infiniteEnergyText = "Make " + ($settings.infiniteEnergy ? "Finite" : "Infinite")>>\
 <span id="infiniteEnergy"><<link _infiniteEnergyText>><<set
    $settings.infiniteEnergy = ~$settings.infiniteEnergy;
    $('#infiniteEnergy a').html("Make " + ($settings.infiniteEnergy ? "Finite" : "Infinite"));
>><</link>></span><</if>>
<<showmeter playerEnergy `$player.energy / 100`>>

:: personProperties {"position":"250,125","size":"200,100"}
<<include npcStats>>
location: $npc.location
<<if $cheat>>\
    Personality preset: $npc.uniqueness.name <<button change>><<set _dialogTitle = "Personality for " + $npc.name>><<dialog _dialogTitle>>\
        <<for _presetIndex = 0; _presetIndex lt PersonUniquenessPresets.length; _presetIndex++>>\
            <<set _preset = PersonUniquenessPresets[_presetIndex]>>\
            <<print '<<button "_preset.name (' + Person.getPersonalityDescription(_preset) + ')">><<set $npc.uniqueness = PersonUniquenessPresets[' + _presetIndex + '];Dialog.close()>><</button>>'>>
        <</for>>\
    <</dialog>><</button>>
    Characteristics: <<- Person.getPersonalityDescription($npc.uniqueness)>>
<</if>>\
:: StoryMenu {"position":"125,125"}
<<link "👨‍👩‍👧‍👦 Character stats">>
    <<dialog "Character stats">>
        <<set _dialogWidth = 'width:' + Math.min(1022, window.innerWidth - 84) + 'px'>>\
        <div class="row" @style="_dialogWidth">\
            <div class="eight columns" id="stats"><br></div>\
            <div class="four columns">\
                <<for _slave range $slaves>>\
                    <<npcGenderSymbol _slave>>\
                    <<print "<<link '_slave.name (_slave.age y.o. _slave.hairColor hair)'>><<set $npc to " + _slave.uid + ">><<replace '#stats'>><<include personProperties>><</replace>><</link>>">>
                <</for>>\
            </div>\
        </div>\
    <</dialog>>
<</link>>
<<link "⚙ Settings">>
    <<dialog Settings>>\
        <style>.addressing{width: 6em;min-width: 0 !important}</style>
        <label class="toggle-button">\
            <input id="toggleEmoji" type="checkbox" class="macro-checkbox"><span>Show emojis</span>\
        </label>\
        <label class="toggle-button">\
            <input id="toggleAnal" type="checkbox" class="macro-checkbox"><span>Show anal content</span>\
        </label>\
        <label class="toggle-button">\
            <input id="toggleSlaveSell" type="checkbox" class="macro-checkbox"><span>Slave selling</span>\
        </label>\
        <div class="row">\
            <div class="one-half column">\
                <h3 style="color:yellow">Child generator</h3>\
                Female percentage:\
                <div class="slidecontainer">\
                    <div style="display:inline-block"><input type="range" min="0" max="100" value="50" class="slider" id="femalePercentSlider"></div>\
                    <div style="display:inline-block;position: relative;top: -11px;">\
                    <input id="femalePercentDisplay" @value="$settings.childGeneration.femalePercentage" style="width: 1.7em;border: 0;pointer-events: none;" readonly> %</div>\
                </div>\
                Females:
                <label>From<input type="number" min="0" id="femaleAgeFrom" style="width:3em">years old</label>
                <label>To &nbsp;<input type="number" id="femaleAgeTo" style="width:3em">years old</label>
                Males:
                <label>From<input type="number" min="0" id="maleAgeFrom" style="width:3em">years old</label>
                <label>To &nbsp;<input type="number" id="maleAgeTo" style="width:3em">years old</label>
                <<button "Hair colors">>\
                    <<userEditListVar "$settings.childGeneration.hairColors" "Edit hair colors">>
                <</button>>\
                <<button "Hair styles">>\
                    <<userEditListVar "$settings.childGeneration.hairStyles" "Edit hair styles">>
                <</button>>\
                <<button "Eye colors">>\
                    <<userEditListVar "$settings.childGeneration.eyeColors" "Edit eye colors">>
                <</button>>\
                <<button "Skins">>\
                    <<userEditListVar "$settings.childGeneration.skins" "Edit skins">>
                <</button>>\
            </div>\
            <div class="one-half column">\
                <h3 style="color:yellow">Change job</h3>\
                Current job: <<- $player.job ? $player.job.name.toUpperFirst() : "Unemployed">>
                <<for _jobKey, _job range Jobs>>\
                    <<set _jobDesc = _job.name.toUpperFirst() + ": Pay:¤" + _job.pay.toFixed(2) + "/day, Go time:" + _job.enterTime>>\
                    <<print '<<button _jobDesc>><<run $player.job = ' + JSON.stringify(_job) + ';Engine.show()>><<dialog "Job changed">>Your job is now: ' + _job.name.toUpperFirst() + '.<</dialog>><</button>>'>>
                <</for>>\
                <<button '<<emoji 🚫>>None'>><<run $player.job = null;Engine.show()>><<dialog "Job changed">>You're now unemployed.<</dialog>><</button>>\
                <div class="row">\
                    <div class="nine columns">\
                        <h3 style="color:yellow">Addressing</h3>\
                        How should your kids call you? (leaving them blank reverts them to default value)
                        Slaves: <input type="text" class="addressing" data-target="slave">
                        Servants: <input type="text" class="addressing" data-target="servant">
                        Lovers: <input type="text" class="addressing" data-target="lover">
                        Your Sons/Daughters: <input type="text" class="addressing" data-target="offspring">
                    </div>\
                    <div class="three columns">\
                        <h3 style="color:yellow">Cheats</h3>\
                        <<set _cheatButtonText = ($cheat ? "Disable" : "Enable") + " Cheats">>\
                        <span id='cheatsButton'><<button _cheatButtonText>>\
                            <<run
                                $cheat = ~$cheat;/*Inverse $cheat value. Anything but true becomes true and true becomes false*/
                                Engine.show();
                                $('#cheatsButton button').text(($cheat ? "Disable" : "Enable") + " Cheats");
                            >>
                        <</button>></span>\
                    </div>\
                </div>\
            </div>\
        </div>\
        <script>
            var $variables = SugarCube.State.variables
            var $settings = $variables.settings
            var defaultOffspringAddr = $variables.player.gender != 'male' ? 'mommy' : 'daddy'
            var addrUpdateValue = function(element){
                var addrDefault = $settings.addressing.slave ? $settings.addressing.slave : $variables.player.name
                switch (element.dataset.target) {
                    case 'slave':
                        element.value = addrDefault
                        break
                    case 'servant':
                        element.value = $settings.addressing.servant ? $settings.addressing.servant : addrDefault
                        break
                    case 'lover':
                        element.value = $settings.addressing.lover ? $settings.addressing.lover : addrDefault
                        break
                    case 'offspring':
                        element.value = $settings.addressing.offspring ? $settings.addressing.offspring : defaultOffspringAddr
                        break
                }
            }
            if($settings.addressing)
                $('.addressing').each(function() {addrUpdateValue(this)})
            else {
                $('.addressing:not([data-target="offspring"])').val($variables.player.name)
                $('.addressing[data-target="offspring"]').val(defaultOffspringAddr)
            }
            $('.addressing').on('input blur', function() {
                var value = this.value.trim()
                if(!$settings.addressing)
                    $settings.addressing = {}
                switch (this.dataset.target) {
                    case 'slave':
                        $settings.addressing.slave = value
                        $('.addressing:not([data-target="offspring"]):not([data-target="slave"])').each(function() {addrUpdateValue(this)})
                        break
                    case 'servant':
                        $settings.addressing.servant = value
                        break
                    case 'lover':
                        $settings.addressing.lover = value
                        break
                    case 'offspring':
                        $settings.addressing.offspring = value
                        break
                }
            })
            $('#toggleEmoji').change(function() {
                var $emoji = $('.emoji')
                if(this.checked)
                    $emoji.show()
                else
                    $emoji.hide()
                $settings.emoji = this.checked
            }).prop('checked', $settings.emoji)
            $('#toggleAnal').change(function() {
                $settings.anal = this.checked
            }).prop('checked', $settings.anal)
            $('#toggleSlaveSell').change(function() {
                $settings.slaveSelling = this.checked
            }).prop('checked', $settings.slaveSelling)
            $("#femalePercentSlider").on("input", function () {
                $settings.childGeneration.femalePercentage = parseInt($(this).val())
                $("#femalePercentDisplay").val($settings.childGeneration.femalePercentage)
            }).val($settings.childGeneration.femalePercentage)
            var $femaleAgeFrom = $('#femaleAgeFrom')
            var $femaleAgeTo = $('#femaleAgeTo')
            var $maleAgeFrom = $('#maleAgeFrom')
            var $maleAgeTo = $('#maleAgeTo')
            $femaleAgeFrom.change(function(){
                var toValue = parseInt($femaleAgeTo.val())
                var $this = $(this)
                var value = Math.min(toValue, parseInt($this.val()))
                $this.val(value)
                $settings.childGeneration.females.fromAge = value
            }).val($settings.childGeneration.females.fromAge)
            $femaleAgeTo.change(function(){
                var fromValue = parseInt($femaleAgeFrom.val())
                var $this = $(this)
                var value = Math.max(fromValue, parseInt($this.val()))
                $this.val(value)
                $settings.childGeneration.females.toAge = value
            }).val($settings.childGeneration.females.toAge)
            $maleAgeFrom.change(function(){
                var toValue = parseInt($maleAgeTo.val())
                var $this = $(this)
                var value = Math.min(toValue, parseInt($this.val()))
                $this.val(value)
                $settings.childGeneration.males.fromAge = value
            }).val($settings.childGeneration.males.fromAge)
            $maleAgeTo.change(function(){
                var fromValue = parseInt($maleAgeFrom.val())
                var $this = $(this)
                var value = Math.max(fromValue, parseInt($this.val()))
                $this.val(value)
                $settings.childGeneration.males.toAge = value
            }).val($settings.childGeneration.males.toAge)
        </script>\
    <</dialog>>\
<</link>>
