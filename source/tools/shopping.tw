:: buyProduct {"position":"0,125"}
$buyProduct.description

<<set
    _own to OnlineStore.destination($buyProduct).get($buyProduct.name);
    _max to (!$buyProduct.available || ($buyProduct.available * $buyProduct.price gt $player.cash)) ?
        Math.floor($player.cash / $buyProduct.price) :
        $buyProduct.available;
    _countName to $buyProduct.itemName ? $buyProduct.itemName.replace(SugarCube.State.variables.buyProduct.name.toLowerCase(), "") : "";
>>\
<<if _own>>\
    You currently own _own.count<<- _countName>>.
<<else>>\
    You don't have any right now.
<</if>>\

<<if $buyProduct.available is not 1>>\
    How many? <input type="number" min="1" @max="_max" value="1" id="buyProductQuantity">
<</if>>\

<span id="spaceAct"><<button "✅ (Space) Order">><<run
    var input = document.getElementById("buyProductQuantity");
    var quantity = input ? input.value : 1;
    if(quantity > 0) {
        var bought = OnlineStore.buy($buyProduct.name, quantity);
        if(bought) {
            Dialog.close();
            $buyProduct = undefined;
            Engine.show();
        }
    }  
>><</button>></span> \
<span id="escAct"><<button "❌ (Esc) Cancel">>
    <<unset $buyProduct>>
    <<dialogclose>>
<</button>></span>\
:: onlineStore [nobr] {"position":"775,1125"}
<<set _page = 0>>
<div class='container' style="text-align: center;">
    <div class='row'><!--https://fictionalcompanies.fandom.com/wiki/Amazoon-->
        <h2 class="passageHead">Anazom</h2><h3 class="passageHead">Next day delivery</h3>
    </div>
    <div id="productList" style="position:relative;padding-bottom:93%">
        <div class='row' style="position:absolute;width:100%"></div>
    </div>
</div>
<div id="nav"></div>
<br class="extraSpace"><br class="extraSpace">
<div class='container'>
    <div style="text-align:right;float:right">
        You currently own ¤<<- $player.cash.toFixed(2)>>
    </div>
    <div id='oneAct' style="float:left">
        <<if State.peek(1).title != State.passage>>
            <<set $returnPassage to State.peek(1).title>>
        <</if>>
        <<keyOption [[Return|$returnPassage]] 🔙>>
    </div>
</div>
<<done>><<run
    var alignImagesVertically = function(){
        setTimeout(function(){$('.shopProduct').each(function(i,slot) {
            var jSlot = $(slot);
            var img = jSlot.find('img')[0];
            if(!img)return;
            var availableHeight = slot.clientHeight - jSlot.find('div')[0].clientHeight - 9;
            if(img.clientHeight < availableHeight)
                img.style.marginTop = ((availableHeight - img.clientHeight) / 2 + 9) + 'px';
        })}, 5);
    };
    var nav = $('#nav').pagination({
        onPageClick: function(pageNumber) {
            $('#productList>div').html('').wiki('<<storeProductList $onlineStore ' + (pageNumber-1) + '>>');
            alignImagesVertically();
        }
    });
    var resizeTimeout;
    var resizeEvent = function() {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(function(){
            $('#productList>div').html('').wiki('<<storeProductList $onlineStore ' + _page + '>>');
            $('#productList').css('padding-bottom', _productListRelHeight + '%');
            if(_pageCount>1)
                nav.show().pagination('updateItems', _pageCount);
            else
                nav.hide();
            alignImagesVertically();
        }, 50)};
    $(window).on('resize', resizeEvent);
    $(document).one(':passageinit ', function(){ $(window).off('resize', resizeEvent) });
    resizeEvent();
>><</done>>
:: receivePacket {"position":"525,775"}
<<scenery home>>
''Delivery man'': "I have a delivery for you"

You received: <<- $onlineStore.bought.items.map(function(item){return item.count + 'x ' + item.name.toUpperFirst()}).join(', ').replace(/, ((?:.(?!, ))+)$/, ' and $1')>>

<<if !Player.hasAchievement("boughtMattress") && OnlineStore.isBought("mattress")>>\
    <<set $achievements.push("boughtMattress")>>\
    ''Delivery man'': "Do you need help you carrying the Mattress?<<emoji 🙂>>"
    ''$player.name'': "NO!!.. No thanks, I can do it myself.<<emoji 😅>>"

<</if>><<if OnlineStore.isBought("infant formula")>>\
    ''You store the infant formula in the kitchen cabinet.''

<</if>>\
<<unlessEmergency>>\
    <<keyOption [[Go back inside|main]] 🔙>>
    <<include workOption>>\
<</unlessEmergency>>
<<run OnlineStore.receiveBought()>>\