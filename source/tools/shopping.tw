:: buyProduct
$buyProduct.description

<<set 
    _own to OnlineStore.destination($buyProduct).get($buyProduct.name);
    _max to (!$buyProduct.available || ($buyProduct.available * $buyProduct.price gt $player.cash)) ?
        Math.floor($player.cash / $buyProduct.price) :
        $buyProduct.available;
    _countName to $buyProduct.itemName ? $buyProduct.itemName.replace(SugarCube.State.variables.buyProduct.name.toLowerCase(), "") : "";
>>\
<<if _own>>\
    You currently own _own.count<<- _countName>>.
<<else>>\
    You don't have any right now.
<</if>>\

<<if $buyProduct.available is not 1>>\
    How many? <input type="number" min="1" @max="_max" value="1" id="buyProductQuantity">
<</if>>\

<span id="spaceAct">\
    <<button "✅ (Space) Order">>\
        <<run
            var input = document.getElementById("buyProductQuantity");
            var quantity = input ? input.value : 1;
            if(quantity > 0) {
                var bought = OnlineStore.buy($buyProductIndex, quantity);
                if(bought) {
                    Dialog.close();
                    Engine.show();
                }
            }
        >>\
    <</button>>\
</span>\
<span id="escAct">\
    <<button "❌ (Esc) Cancel">>\
        <<run Dialog.close()>>\
    <</button>>\
</span>\
:: onlineStore [nobr]
<<if $onlineStore.version < 2>>>
    <<run OnlineStore.update()>>
<</if>>
<div class='container' style="text-align: center;">
    <div class='row'><!--https://fictionalcompanies.fandom.com/wiki/Amazoon-->
        <h2>Anazom</h2><h3>Next day delivery</h3>
    </div>
    <div class='row' style="display: inline-block;width: 100%;">
        <<for _productIndex to 0; _productIndex lt $onlineStore.products.length; _productIndex++>>
            <<set 
                _product = $onlineStore.products[_productIndex];
                _priceStyle = "color:" + (_product.price > $player.cash ? "red" : "#8af");
            >>
            <<if !_product.soldOut>>
                <a class="product" @data-productindex="_productIndex" @data-product="JSON.stringify(_product)">
                    <div class='four columns shopProduct'>
                        <<itemImage _product.name>>
                        <div><<- OnlineStore.productText(_product)>><span @style="_priceStyle"><<-  OnlineStore.priceText(_product)>></span></div>
                    </div>
                </a>
            <</if>>
        <</for>>
    </div>
    <br><br>
    <div class='row'>
        <div id='oneAct' class="three columns">
            <<if State.peek(1).title != State.passage>>
                <<set $returnPassage to State.peek(1).title>>
            <</if>>
            <<keyOption Return $returnPassage 🔙>>
        </div>
        <div class="nine columns" style="text-align:right">
            You currently own $$$player.cash
        </div>
    </div>
</div>
<script>
    $('.product').each(function() {
        let $this = $(this);
        let index = $this.data('productindex');
        if(OnlineStore.canBuy(index))
            $this.on('click', function() {
                SugarCube.State.variables.buyProduct = $this.data('product');
                SugarCube.State.variables.buyProductIndex = index;
                SugarCube.Dialog.setup("Buy " + SugarCube.State.variables.buyProduct.name);
                SugarCube.Dialog.wiki(SugarCube.Story.get("buyProduct").processText());
                SugarCube.Dialog.open();
            });
    });
</script>
:: receivePacket
<<scenery home>>
''Delivery man'': "I have a delivery for you"

You received: <<- $onlineStore.bought.items.map(function(item){return item.count + 'x ' + item.name.charAt(0).toUpperCase() + item.name.slice(1)}).join(', ').replace(/, ((?:.(?!, ))+)$/, ' and $1')>>

<<if !Player.hasAchievement("boughtMattress") && OnlineStore.isBought("mattress")>>\
    <<set $achievements.push("boughtMattress")>>\
    ''Delivery man'': "Do you need help you carring the Matress?<<emoji 🙂>>"
    ''$player.name'': "NO!!.. No thanks, I can do it myself.<<emoji 😅>>"

<</if>>\
<<unlessEmergency>>\
    <<keyOption "Go back inside" main 🔙>>
    <<include workOption>>\
    <<keyOption "Look for kids in the playground" playground ⚽>>
<</unlessEmergency>>\
<<run OnlineStore.receiveBought()>>\