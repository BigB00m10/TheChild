:: widgets [widget nobr]
<<widget emoji>>
    <<if $settings.emoji === false>>
        <<set _style to "display:none">>
    <</if>>
    <span class='emoji' @style="_style">_args[0]</span>
<</widget>>
<<widget addMinutes>>
    <<run Now.addMinutes(_args[0])>>
<</widget>>
<<widget addHours>>
    <<run Now.addHours(_args[0])>>
<</widget>>
<<widget cash>>
    <<run $player.cash = Math.round(($player.cash + _args[0]) * 100) / 100
        ;_cashAction = _args[0] < 1 ? 'lost' : 'received'
        ;_cashColor = _args[0] < 1 ? 'red' : 'green'>>
    @@color:_cashColor;You _cashAction ¤<<- _args[0].toFixed(2)>>@@
<</widget>>
<<widget workOption>>
    <<set _workEmoji = $player.gender != "male" ? "👷‍♀️" : "👷‍♂️"; _workText = "Go to work" + (Now.isWeekend()?" (Optional)":"")>>
    <<keyOption _workText work _workEmoji>>
<</widget>>
<<widget sleep>>
    <<set $player.sleeping = true;
        Now.skipTo("7:00 AM")>>
    <<goto bed>>
<</widget>>
<<widget unlessEmergency container>>
    <<if $player.energy lt 1>>
        @@color:red;You REALLY need to sleep@@<br>
        <<keyAction 'Go to sleep' 😴>><<sleep>><</keyAction>>
    <<else>>
        <<if !Now.isWeekend() && !$player.workedToday && Now.isEqualOrLaterThan($player.job.enterTime)>>
            @@color:red;You need to go to work@@<br>
            <<workOption>>
        <<else>>
            _contents
        <</if>>
    <</if>>
<</widget>>
<<widget checkNpcVirgin>>
    <<set _fieldName to _args[0]+'Virgin'>>
    <<if $npc[_fieldName]>>
        <<set $npc[_fieldName] to false>>
        <<if $npc.index != undefined>>
            <<set $slaves[$npc.index][_fieldName] to false>>
        <</if>>
        @@color:red;$npc.name just lost $npc.possessive _args[0] virginity!!!@@<br>
    <</if>>
<</widget>>
:: workOption
<<if !$player.workedToday && Now.isBetween("7:00 AM", "2:00 PM")>>\
    <<workOption>>
<</if>>\
:: npcStats [nobr]
<<run
    ['love', 'obedience', 'lust', 'pussyTraining', 'anusTraining', 'mouthTraining'].forEach(function(name) {
        Meter.del(name);
        Meter.add(name, { 
            label: name.beautifyStat() + ':' + $npc[name],
            height: '20px'
        }, $npc[name] / 100);
    });
    ['freedomWish', 'hunger', 'fear'].forEach(function(name) {
        Meter.del(name);
        Meter.add(name, { 
            label: name.beautifyStat() + ':' + $npc[name],
            height: '20px',
            full: '#FF4136',
            empty: '#2ECC40'
        }, $npc[name] / 100);
    });
>>
<div class="row">
    <<if $npc.fear>>
        <div class="one-third column">
            <<showmeter fear>>
        </div>
    <</if>>
    <<if $npc.love>>
        <div class="one-third column">
            <<showmeter love>>
        </div>
    <</if>>
    <<if $npc.obedience>>
        <div class="one-third column">
            <<showmeter obedience>>
        </div>
    <</if>>
</div>
<div class="row">
    <<if $npc.lust>>
        <div class="one-third column">
            <<showmeter lust>>
        </div>
    <</if>>
    <<if $npc.freedomWish>>
        <div class="one-third column">
            <<showmeter freedomWish>>
        </div>
    <</if>>
    <<if $npc.hunger>>
        <div class="one-third column">
            <<showmeter hunger>>
        </div>
    <</if>>
</div>
<div class="row">
    <<if $npc.pussyTraining>>
        <div class="one-third column">
            <<showmeter pussyTraining>>
        </div>
    <</if>>
    <<if $npc.anusTraining>>
        <div class="one-third column">
            <<showmeter anusTraining>>
        </div>
    <</if>>
    <<if $npc.mouthTraining>>
        <div class="one-third column">
            <<showmeter mouthTraining>>
        </div>
    <</if>>
</div>
:: npcInteraction [nobr]
<<scenery $scenery>>
<<unlessEmergency>>
    <<npcInteraction>>
<</unlessEmergency>>