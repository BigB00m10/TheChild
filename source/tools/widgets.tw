:: widgets [widget nobr] {"position":"425,300"}
<<widget emoji>><<if $settings.emoji === false>><<set _style to "display:none">><</if>><span class='emoji' @style="_style">_args[0]</span><</widget>>
<<widget addMinutes>>
    <<run Now.addMinutes(_args[0])>>
<</widget>>
<<widget addHours>>
    <<run Now.addHours(_args[0])>>
<</widget>>
<<widget cash>>
    <<run $player.cash = Math.round(($player.cash + _args[0]) * 100) / 100
        ;_cashAction = _args[0] < 1 ? 'lost' : 'received'
        ;_cashColor = _args[0] < 1 ? 'red' : 'green'>>
    @@color:_cashColor;You _cashAction ¤<<- Math.abs(_args[0]).toFixed(2)>>@@
<</widget>>
<<widget workOption>>
    <<set _workEmoji = $player.gender != "boy" ? "👷‍♀️" : "👷‍♂️"; _workText = "Go to work" + (Now.isWeekend()?" (Optional)":"")>>
    <<keyOption [[_workText|work]] _workEmoji>>
<</widget>>
<<widget sleep>>
    <<set $player.sleeping = true;
        Now.skipTo("7:00 AM")>>
    <<goto bed>>
<</widget>>
<<widget checkNpcVirgin>>
    <<set _fieldName to _args[0] + 'Virgin'>>
    <<if $npc[_fieldName]>>
        <<set
            $npc[_fieldName] = false;
            Person.setAchievement("playerTook" + _args[0].toUpperFirst() + "Virginity");
        >>
        <br>@@color:red;$npc.name just lost $npc.possessive _args[0] virginity!!!@@<br>
    <<elseif _args[0] != 'mouth' && !Person.hasAchievement("playerTook" + _args[0].toUpperFirst() + "Virginity") && !Person.hasAchievement("playerRealizedNonVirgin")>>
        <br>@@color:yellow;You realize that $npc.name was not a virgin!!@@<br>
        <<run Person.setAchievement("playerRealizedNonVirgin")>>
    <</if>>
    <<run Person.setAchievement('had' + _args[0].toUpperFirst() + 'SexWithPlayer')>>
<</widget>>
<<widget userEditListVar>>
    <<set _list = eval(_args[0]).join('\n')>>
    <<dialog _args[1]>>
        <<textarea "_newList" _list>><br>
        <<button "✅ Save">>
            <<run eval(_args[0] + '=' + JSON.stringify(_newList.split(/\r?\n/)));Dialog.close()>>
        <</button>>
        <<if _args[2]>>
            <<button "♻ Reset to default">><<set
                _newList = eval(_args[2]).join('\n');
                $('#textarea--newlist').val(_newList);  
            >><</button>>
        <</if>>
        <span id="escAct"><<button "❌ (Esc) Cancel">>
            <<dialogclose>>
        <</button>></span>
    <</dialog>>
<</widget>>
<<widget npcAddressPlayer>><<- Player.getAddressing(_args[0] || $npc)>><</widget>>
<<widget npcStats>>
    <<set 
        _npc = _args[0] ? _args[0] : $npc;
        if(typeof _npc == 'number')
            _npc = Person.get(_npc);
    >>
    <<run
        ['love', 'obedience', 'lust', 'pussyTraining', 'anusTraining', 'mouthTraining'].forEach(function(name) {
            Meter.del(name);
            Meter.add(name, {
                label: name.beautifyStat() + ':' + _npc[name],
                height: '20px'
            }, _npc[name] / 100);
        });
        ['freedomWish', 'hunger', 'fear'].forEach(function(name) {
            Meter.del(name);
            Meter.add(name, {
                label: name.beautifyStat() + ':' + _npc[name],
                height: '20px',
                full: '#FF4136',
                empty: '#2ECC40'
            }, _npc[name] / 100);
        });
    >>
    <div class="row">
        <<if _npc.fear>>
            <div class="one-third column">
                <<showmeter fear>>
            </div>
        <</if>>
        <<if _npc.love>>
            <div class="one-third column">
                <<showmeter love>>
            </div>
        <</if>>
        <<if _npc.obedience>>
            <div class="one-third column">
                <<showmeter obedience>>
            </div>
        <</if>>
    </div>
    <div class="row">
        <<if _npc.lust>>
            <div class="one-third column">
                <<showmeter lust>>
            </div>
        <</if>>
        <<if _npc.freedomWish>>
            <div class="one-third column">
                <<showmeter freedomWish>>
            </div>
        <</if>>
        <<if _npc.hunger>>
            <div class="one-third column">
                <<showmeter hunger>>
            </div>
        <</if>>
    </div>
    <div class="row">
        <<if _npc.pussyTraining>>
            <div class="one-third column">
                <<showmeter pussyTraining>>
            </div>
        <</if>>
        <<if _npc.anusTraining>>
            <div class="one-third column">
                <<showmeter anusTraining>>
            </div>
        <</if>>
        <<if _npc.mouthTraining>>
            <div class="one-third column">
                <<showmeter mouthTraining>>
            </div>
        <</if>>
    </div>
<</widget>>
<<widget personProperties>>
    <<set 
        _npc = _args[0] || $npc;
        if(typeof _npc == 'number')
            _npc = Person.get(_npc);
        _location = _npc.location;
        var holder = Person.getHolder(_npc);
        if(holder){
            if(holder.uid==0){
                _location = $scenery;
                _extraLocationInfo = '(Held by the player)';
            }else{
                _location = holder.location;
                _extraLocationInfo = `(On ${holder.name}'s arms)`;
            }
        }
        _passage = _location == 'mainRoom' ? 'main' : _location;
        Meter.del('ageProgress');Meter.add('ageProgress',{
            label:'Aging Progress',
            height:'20px',
            full:'#777',
            empty:'#777'
        }, _npc.ageProgress / ($settings.agingIgDays ? $settings.agingIgDays : 365.25));
    >>
    <<npcStats _npc>>
    Location: <<- _location.beautifyStat()>><<if _extraLocationInfo>> _extraLocationInfo<</if>> <<button "Go there" _passage>><<dialogclose>><</button>><br>
    <<showmeter ageProgress>>
    <<if $cheat>>\
        Personality preset: _npc.uniqueness.name <<button change>><<set _dialogTitle = "Personality for " + _npc.name>><<dialog _dialogTitle>>
            <<for _presetIndex = 0; _presetIndex lt PersonUniquenessPresets.length; _presetIndex++>>
                <<set _preset = PersonUniquenessPresets[_presetIndex]>>
                <<print '<<button "_preset.name (' + Person.getPersonalityDescription(_preset) + ')">><<set _npc.uniqueness = PersonUniquenessPresets[' + _presetIndex + '];Dialog.close()>><</button>>'>>
                <<unset _preset>>
            <</for>>
        <</dialog>><</button>><br>
        Characteristics: <<- Person.getPersonalityDescription(_npc.uniqueness)>>
        <br>Impregnation chance:<input type=number min=0 max=100 style="width:3em" id=impregnationChance>%
        <br><label class="toggle-button">
            <input id="toggleAging" type="checkbox" class="macro-checkbox"><span>Stop aging</span>
        </label>
        <br><<button 'Age up right now'>>
            <<set _dialogTitle='Aging up ' + _npc.name>>
            <<dialog _dialogTitle>>
                Are you sure you want to age up _npc.name?
                This action cannot be reversed in the future.
                <br><span id="spaceAct"><<button "✅ (Space) Yes">>
                    <<set
                        _npc.age++;
                        _npc.ageProgress = 0;
                        Person.adjustPubescence(true, _npc);
                        Person.manageHolder(_npc, Person.getHolder(_npc));
                    >>
                    <<dialogclose>>
                <</button>></span>
                <span id="escAct"><<button "❌ (Esc) Cancel">>
                    <<dialogclose>>
                <</button>></span>
            <</dialog>>
        <</button>><br><<if _npc.pregnantDays != undefined>>_npc.pregnantDays days pregnant. <<button 'Give birth right now'>>
            <<run Person.showBirthMessage(Person.giveBirth(_npc), _npc)>>
        <</button>><</if>>
        <<done>><<run
            Player.bindSettingDom('toggleAging', _npc, 'stopAging');
            Player.bindSettingDom('impregnationChance', _npc, 'impregnationChance');
        >><</done>>\
    <</if>>
    <<unset _location>>
    <<unset _extraLocationInfo>>
<</widget>>
<<widget npcGenderSymbol>>
    <<set _genderSymbol = _args[0].sex == 'male' ? '♂' : _args[0].sex == 'female' ? '♀' : '⚤'>>
    <<emoji _genderSymbol>><<unset _genderSymbol>>
<</widget>>
<<widget printPersonLink>>
    <<npcGenderSymbol _args[0]>>
    <<print "<<link '" + (_args[2] ? _args[2] + ' ' : '') +  Person.getShortDescription(_args[0]) + "'>>" + _args[1] + "<</link>>">>
<</widget>>
<<widget wanderingSlaves>>
    <<set _wandering = Person.getWandering()>>
    <<if _wandering.length>>
        <<if _wandering.length == 1>>
            <<set _linkText = "(A) " + _wandering[0].name>>
            <span id="aKeyAct"><<link _linkText>><<openNpcInteraction houseSlave _wandering[0].uid>><</link>></span> is here.<br>
        <<else>>
            <<set 
                _last = _wandering.pop();
                _charcode = 97;
            >>
            <<for _slave range _wandering>>
                <<set
                    if(_charcode == 104) _charcode += 2; 
                    _char = String.fromCharCode(_charcode++);
                    _linkText = '(' + _char.toUpperCase() + ') ' + _slave.name;
                    _keyId = _char + 'KeyAct';
                >><span @id='_keyId'><<print '<<link _linkText>><<openNpcInteraction houseSlave ' + _slave.uid + '>><</link>>'>></span>,
            <</for>>
            <<set 
                _char = String.fromCharCode(_charcode);
                _linkText = '(' + _char.toUpperCase() + ') ' + _last.name;
                _keyId = _char + 'KeyAct';
            >>
            and <span @id='_keyId'>
                <<link _linkText>><<openNpcInteraction houseSlave _last.uid>><</link>>
            </span> are here.<br>
        <</if>>
    <</if>>
<</widget>>
<<widget playerSay>>''$player.name'': "_args[0]"<</widget>>
<<widget npcSay>>
    <<set _npc = _args[1] ? _args[1] : $npc>>
    ''_npc.name'': "_args[0]"
    <<unset _npc>>
<</widget>>
<<widget personImage>>
    <div class="characterImage">
        <div id="characterImageFixed">
            <img id="characterImageAnim">
        </div>
    </div>
    <<done>><<run
        let person = Object.assign({},_args[0]);
        if(!person.expression)
            person.expression = person.status == 'citizen' || person.fear < 10 || person.love > person.fear + 20 ? 'smile' : 'frown';
        if(!Assets.character.hair.spriteCollections.firstOrDefault(c=>c.match.hairStyle == person.hairStyle))
            person.hairStyle = 'straight';
        let fixed = document.getElementById('characterImageFixed'),anim = document.getElementById('characterImageAnim');
        personImage(person).then(url => url && tempObjectUrl(fixed.style.backgroundImage = `url(${url})`));
        personImage(person, 'animation').then(urlOpen =>{
            if(!urlOpen) {
                anim.style.display = 'none';
                return;
            }
            anim.src = tempObjectUrl(urlOpen);
            person.eyesClosed = true;
            personImage(person, 'animation').then(urlClose =>{
                tempObjectUrl(urlClose);
                let stop = false, blink;
                $(document).on(':passageinit', ()=>stop=true);
                (blink = ()=>setTimeout(()=>{
                    if(stop)return;
                    anim.src=urlClose;
                    setTimeout(()=>{
                        if(stop)return;
                        anim.src=urlOpen;
                        blink();
                    },50);
                },Math.random()*4000+2000))();
            });
        });
    >><</done>>
<</widget>>
<<widget personHunting>>
    <<set
        _hasChloroform = Player.has('chloroform', true);
        _hasCandy = Player.has('Candy');
        $found_kid = Person.generate($settings.childGeneration);
    >>
    <<npcInteractionLayout '$found_kid'>>
        You found a <<- Person.getLongDescription($found_kid)>> named $found_kid.name<br><br>
        <<magicSunglasses $found_kid>>
    <</npcInteractionLayout>>
    <<if !_hasChloroform and !_hasCandy>>
        (You don't have anything at your disposal to obtain kids. Try the online store on the computer in your room)<br>
    <<elseif Basement.availableBeds() lte 0>>
        (Not enough space for a new kid back at home)<br>
    <<else>>
        <<if _hasCandy>>
            <<keyOption [[Offer $found_kid.name some Candy.|CandyLure]] 🍬>>: 9min
        <</if>>
        <<if _hasChloroform>>
            <br><<keyOption [[Kidnap $found_kid.pronoun|kidnap]] 🖐>>: 30min
        <</if>>
    <</if>>
<</widget>>
<<widget magicSunglasses>>
    <<if Player.has('magic sunglasses')>>
        <<set _npc to _args[0] || $npc>>
        <label style="cursor:pointer"><<checkbox '$settings.usingMagicSunglasses' false true autocheck>> Put on magic sunglasses.<<emoji 😎>></label><br>
        <<set _npcStatsStyle = $settings.usingMagicSunglasses ? '' : 'display:none'>>
        <span id='npcStats' @style='_npcStatsStyle'>
            <<if passage()!='npcInteraction'>><<npcStats _npc>><</if>>
            Traits: <<- Person.getPersonalityDescription(_npc.uniqueness)>><br>
        </span><br>
        <script>
            $('#checkbox-settingsusingmagicsunglasses').on('change', function() {
                $('#npcStats').toggle(this.checked)
            })
        </script>
    <</if>>
<</widget>>
<<widget sleepOption>>
    <<if !$player.job or $player.workedToday or Now.isWeekend() or Now.isBetween('12:00 AM', '06:59 AM')>>
        <<set 
            _sleepSlave = Person.firstOrNull(function(npc){return Person.hasAchievement('okSleepWithPlayer', npc)});
            _sleepSentence = $scenery != 'bed' ? "Go sleep" : 'Sleep';
        >>
        <<if _sleepSlave>>
            <<set _sleepSentence+=' with ' + _sleepSlave.name>>
            <<keyAction _sleepSentence 🥰>>
                <<set $scenery = 'bed'>>
                <<openNpcInteraction 'okSleepWithPlayerDemand' _sleepSlave.uid>>
            <</keyAction>>
        <<else>>
            <<keyAction _sleepSentence 😴>><<sleep>><</keyAction>>
        <</if>><br>
    <</if>>
<</widget>>
<<widget thirdPerson>><<set _npc = _args[2] ? Person.get(_args[2]) : $npc>><<if _npc.gender != 'nb'>>_args[0]<<else>>_args[1]<</if>><</widget>>
<<widget slaveEvents>>
    <<set _eventSlaves = window[_args[0]].getEventSlaves()>>
    <<set _eventIndex to 0>>
    <<include slaveEvent>><<if _eventSlaves.length>><br><</if>>
<</widget>>
<<widget showCookFeedingRules>>
    <<dialog "Cook feeding rules">>
        <label><input type="checkbox" id="feedEnabled">Feed all the slaves that have at least </label><input type="number" id="feedAtHunger" style="width:3em" min="1" max="100">hunger.<br>
        Those slaves will be fed at 7AM, 1PM and 7PM<br>
        <div class="row">
            <div class="one-half column">
                Special cases:<br>
                <span id="exceptionList"><<include cookFeedExceptions>></span>
                <br><button id="addExceptionBtn">Add exception</button>
            </div><div class="one-half column" id="exceptionEditor"></div>
        </div>
        <<done>><<run
            Player.bindSettingDom('feedEnabled',$settings.cook,'feedEnabled');
            Player.bindSettingDom('feedAtHunger',$settings.cook,'feedAtHunger');
            $('#addExceptionBtn').on('click',function(){
                var exceptionEditor = $('#exceptionEditor').html('<h3>New exception</h3>\
                    Slave:\
                    <select id="exceptionSlaveSelect" style="width:100%"></select>\
                    <label><input type="checkbox" id="exceptionFeedEnabled" checked>Feed this the slave when they have at least </label><input type="number" id="exceptionFeedAtHunger" style="width:3em" min="1" max="100" value="20">hunger.\
                    <br><button id="saveExceptionBtn">Save</button>');
                var exceptionSlaveSelect = $('#exceptionSlaveSelect').select2({
                    placeholder:"Select slave...",
                    dropdownParent:exceptionEditor,
                    data:Person.all(function(slave) {
                        return !$settings.cook.exceptions.find(function(ex){ return ex.npc == slave.uid; });
                    }).map(function(slave){return {
                        id: slave.uid,
                        text: Person.getShortDescription(slave, true)
                    }})
                }).val(null).trigger('change');
                $('#saveExceptionBtn').on('click',function(){
                    var slaveId=exceptionSlaveSelect.val();
                    if(!slaveId)return;
                    $settings.cook.exceptions.push({
                        npc:slaveId,
                        feedEnabled:$('#exceptionFeedEnabled').is(':checked'),
                        feedAtHunger:$('#exceptionFeedAtHunger').val()
                    });
                    exceptionEditor.html('');
                    $('#exceptionList').html('').wiki('<<include cookFeedExceptions>>');
                });
            });
        >><</done>>
    <</dialog>>
<</widget>>
<<widget storeProductList>>
    <<set 
        var filterTag = _args[2];
        var search = _args[3] ? _args[3].trim() : null;
        if(window.innerWidth < 550) {
            _productsPerPage = Math.floor((window.innerHeight - 227) / (window.innerWidth * 0.225)) + 1;
            _productListRelHeight = _productsPerPage * 31.3;
        } else {
            if(window.innerHeight < 550) {
                _productsPerPage = 3;
                _productListRelHeight = 31;
            } else if(window.innerHeight < 842) {
                _productsPerPage = 6;
                _productListRelHeight = 62;
            } else {
                _productsPerPage = 9;
                _productListRelHeight = 93
            }
        }
        _products = _args[0].products.filter(function(product){
            var matches = true;
            if(search) {
                matches = product.name.includes(search);
                if(!matches)
                    matches = product.description.includes(search);
                if(!matches)
                    matches = product.tags.has(search);
            }
            return !product.soldOut && (!filterTag || product.tags.has(filterTag)) && matches;
        });
        _pageCount = Math.ceil(_products.length / _productsPerPage);
        _page = Math.min(_args[1], _pageCount - 1);
        _productIndex = _page * _productsPerPage;
        _endIndex = Math.min(_products.length, _productIndex + _productsPerPage);
    >>
    <<for ; _productIndex lt _endIndex; _productIndex++>>
        <<set
            _product = _products[_productIndex];
            _priceStyle = "color:" + (_product.price > $player.cash ? "red" : "#8af");
        >>
        <a class="product" @data-product="JSON.stringify(_product)">
            <div class='four columns shopProduct'>
                <<itemImage _product.name>>
                <div><<- OnlineStore.productText(_product)>><span @style="_priceStyle"><<- OnlineStore.priceText(_product)>></span></div>
            </div>
        </a>
    <</for>>
    <<done>><<run
        $('.product').each(function() {
            var productDom = $(this);
            var product = productDom.data('product');
            if(OnlineStore.canBuy(product.name))
                productDom.on('click', function() {
                    $buyProduct = product;
                    SugarCube.Dialog.setup("Buy " + product.name);
                    SugarCube.Dialog.wiki(SugarCube.Story.get("buyProduct").processText());
                    SugarCube.Dialog.open();
                });
        });
    >><</done>>
<</widget>>
<<widget scenery>>\
    <<set $scenery = _args[0];_url = Assets.scenery[$scenery]>>
    <<if _url && !$settings.hideScenery>>\
        <img class="centerHouse" @src="_url"><<unset _url>>
    <</if>>\
<</widget>>\
<<widget homeSpaceContainerOption>>
    <<set
        _actionText = 'Check the ' + _args[1];
        _dialogTitle = _args[0].toLowerCase().toUpperFirst() + ' ' + _args[1].toUpperFirst();
        _homeSpaceItems = window[_args[0]].getContents().items;
    >>
    <<if _homeSpaceItems.length>><<keyAction _actionText 🗄>><<dialog _dialogTitle>>\
        <<for _item range _homeSpaceItems>>\
            <<print OnlineStore.getInventoryLine(_item)>><br>
        <</for>>\
    <</dialog>><</keyAction>><br><</if>>
<</widget>>
:: workOption {"position":"875,0"}
<<if $player.job && !$player.workedToday && Now.isBetween("7:00 AM", "2:00 PM")>>\
    <<workOption>>
<</if>>\
