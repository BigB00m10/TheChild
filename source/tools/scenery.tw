:: scenery [widget] {"position":"1125,0"}
<<widget scenery>>\
    <<nobr>>\
        <<set _base64 to null;$scenery to _args[0]>>
        <<switch $scenery>>
            <<case dump>>
                <<set _base64 to "">>
            <<case playground>>
                <<set _base64 to "">>
            <<case bed>>
                <<set _base64 to "">>
            <<case mainRoom>>
                <<set _base64 to "">>
            <<case basement>>
                <<set _base64 to "">>
            <<case home>>
                <<set _base64 to "">>
            <<case bat>>
                <<set _base64 to "">>
            <<case wc>>
                <<set _base64 to "">>
            <<case garden>>
                <<set _base64 to "">>
            <<case shool>>
                <<set _base64 to "">>
        <</switch>>
    <</nobr>>\
    <<if _base64 != null && !$settings.hideScenery>>\
        <<set _base64 to "data:image/jpeg;base64," + _base64>>\
        <img class="centerHouse" @src="_base64">
        <hr>
    <</if>>\
<</widget>>\