:: widgets [widget nobr]
<<widget emoji>>
    <<if $settings.emoji === false>>
        <<set _style to "display:none">>
    <</if>>
    <span class='emoji' @style="_style"><<- _args[0]>></span>
<</widget>>
<<widget addMinutes>>
    <<run Now.addMinutes(_args[0])>>
<</widget>>
<<widget addHours>>
    <<run Now.addHours(_args[0])>>
<</widget>>
<<widget cash>>
    <<run $player.cash += _args[0]
        ;_cashAction = _args[0] < 1 ? 'lost' : 'received'
        ;_cashColor = _args[0] < 1 ? 'red' : 'green'>>
    @@color:_cashColor;You _cashAction $$_args[0]@@
<</widget>>
<<widget workOption>>
    <<set _workEmoji = $player.gender != "male" ? "👷‍♀️" : "👷‍♂️">>
    <<keyOption "Go to work" work _workEmoji>>
<</widget>>
<<widget unlessLateToJob container>>
    <<if !$player.workedToday && Now.isEqualOrLaterThan($player.job.enterTime)>>
        @@color:red;You need to go to work@@<br>
        <<workOption>>
    <<else>>
        _contents
    <</if>>
<</widget>>
:: workOption
<<set Now.date = $now.date>>\
<<if !$player.workedToday && Now.isBetween("7:00 AM", "2:00 PM")>>\
    <<workOption>>
<</if>>\
:: npcStats [nobr]
<<run
    ['love', 'obedience', 'lust'].forEach(function(name) {
        Meter.del(name);
        Meter.add(name, { 
            label: (name.charAt(0).toUpperCase() + name.slice(1)).replace(/(\B[A-Z])/g, ' $1') + ':' + $npc[name],
            height: '20px'
        }, $npc[name] / 100);
    });
    ['freedomWish', 'hunger', 'fear'].forEach(function(name) {
        Meter.del(name);
        Meter.add(name, { 
            label: (name.charAt(0).toUpperCase() + name.slice(1)).replace(/(\B[A-Z])/g, ' $1') + ':' + $npc[name],
            height: '20px',
            full: '#FF4136',
            empty: '#2ECC40'
        }, $npc[name] / 100);
    });
>>
<div class="row">
    <div class="one-third column">
        <<showmeter fear>>
    </div>
    <div class="one-third column">
        <<showmeter love>>
    </div>
    <div class="one-third column">
        <<showmeter obedience>>
    </div>
</div><br>
<div class="row">
    <div class="one-third column">
        <<showmeter lust>>
    </div>
    <div class="one-third column">
        <<showmeter freedomWish>>
    </div>
    <div class="one-third column">
        <<showmeter hunger>>
    </div>
</div>
:: npcInteraction [nobr]
<<scenery $scenery>>
<<unlessLateToJob>>
    <<npcInteraction $npcInteractionRoute>>
<</unlessLateToJob>>